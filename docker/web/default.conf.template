server {
  listen 8080;
  server_name _;

  location = /healthz {
    default_type text/plain;
    return 200 "ok\n";
  }

  location = /version {
    default_type text/plain;
    return 200 "${APP_VERSION}\n";
  }

  location = / {
    default_type text/plain;
    return 200 "${GREETING}\n";
  }
}
